# Infrastructure (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://wts:wts@localhost:55432/wts
REDIS_URL=redis://localhost:6380/0

# LLM routing — any LiteLLM model string. Each task can use a different model.
LLM_MODEL_CLUSTER_NAMING=anthropic/claude-sonnet-5-5
LLM_MODEL_OPPORTUNITY=anthropic/claude-opus-5-5
LLM_MODEL_VERDICT=anthropic/claude-opus-5-5
# Provider keys (LiteLLM reads these directly)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Channels (phase 2)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=WhatToSell/0.1
TIKTOK_MS_TOKEN=
DTK_BASE_URL=http://localhost:8000
